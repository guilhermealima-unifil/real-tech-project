# Nunca commitar o .env real — só este exemplo.
# Preenchido automaticamente ao criar o banco na Vercel (Storage → Prisma
# Postgres) e rodar `vercel env pull .env` (ver docs/01-passo-a-passo-vercel-prisma.md).

DATABASE_URL=

# Alguns provedores (ex.: Neon) também exigem DIRECT_URL para migrations.
# DIRECT_URL=

# Gemini Developer API (Google AI Studio) — só usada para a "Leitura
# inteligente" de Comparar estratégias (src/app/api/leitura-comparacao).
# Free tier, sem billing necessário. Sem esta chave, a leitura determinística
# de fallback continua funcionando normalmente (ver src/lib/leituraComparacaoFallback.ts).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
